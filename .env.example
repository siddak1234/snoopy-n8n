# Shared defaults (copy to .env.local or .env.prod)
N8N_PORT=5678
NODE_FUNCTION_ALLOW_EXTERNAL=pdf-lib
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# Security (must be replaced per environment)
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_LONG_RANDOM
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# Timezone
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago
