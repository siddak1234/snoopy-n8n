# Local development example (copy to .env.local)
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678
NODE_FUNCTION_ALLOW_EXTERNAL=pdf-lib
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Security (local-only sample values)
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_LONG_RANDOM
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# Timezone
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago

