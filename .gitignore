# Dependencies
node_modules/

# Logs
*.log

# Runtime data
*.pid
*.pid.lock
*.seed

# TypeScript cache
*.tsbuildinfo

# npm
.npm
*.tgz

# ----------------------------
# n8n specific
# ----------------------------

# Persistent storage (database, credentials, executions)
data/
.n8n/

# Docker volumes (if using postgres/redis)
postgres_data/
redis_data/

# ----------------------------
# Secrets — never commit
# ----------------------------
.env
.env.*
!.env.local.example
!.env.prod.example
secrets/*
!secrets/.gitkeep

# ----------------------------
# OS / editor
# ----------------------------
.DS_Store
.vscode/
.idea/
.claude/

# Misc
tmp/
.ngrok2/

# Recovered client data. `_salvage/` holds the n8n workflow export and the legacy
# database archive: real customer email addresses, vendor names, and dollar
# amounts. It belongs in encrypted storage, not in git — history is permanent, so
# deleting the file later does not undo the commit. CI fails if one is tracked.
_salvage/
