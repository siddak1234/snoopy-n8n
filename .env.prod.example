# Production on any Linux VM (DigitalOcean, AWS, Azure, GCP, Hetzner, etc.)
# Copy to .env.prod and fill in real values. Do not commit .env.prod.
#
# Default startup (provider-agnostic):
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Optional GCP metadata ADC: add -f docker-compose.gcp.yml — see docs/deploy-gcp.md

# --- Core n8n (required) ---
N8N_ENCRYPTION_KEY=<replace_me>
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<replace_me>

# --- Networking (required — must match how users reach n8n) ---
# Direct VM IP: N8N_PROTOCOL=http, N8N_PROXY_HOPS=0
# Behind HTTPS reverse proxy: N8N_PROTOCOL=https, N8N_PROXY_HOPS=1 (or more if multiple proxies)
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_PROXY_HOPS=1

# --- App ---
NODE_FUNCTION_ALLOW_EXTERNAL=pdf-lib
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago



