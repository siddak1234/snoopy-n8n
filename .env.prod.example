# Production example (copy to .env.prod and inject real secrets securely)
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com
N8N_PROXY_HOPS=1
N8N_ENCRYPTION_KEY=<replace_me>
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=<replace_me>
N8N_BASIC_AUTH_PASSWORD=<replace_me>
NODE_FUNCTION_ALLOW_EXTERNAL=pdf-lib
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
GENERIC_TIMEZONE=America/Chicago
TZ=America/Chicago
